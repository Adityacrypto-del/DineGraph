# DineGraph backend settings. Copy this file to .env and fill in what you need:
#   cp .env.example .env
# Variables already set in your shell win over this file. Never commit .env.

# --- Claude -------------------------------------------------------------------
# Your Anthropic API key. Without one, set DINEGRAPH_OFFLINE=1.
# ANTHROPIC_API_KEY=sk-ant-...
# Claude model used to read orders and write replies.
DINEGRAPH_MODEL=claude-opus-5
# 1 = use the built-in rule-based parser instead of Claude (no key, no cost).
DINEGRAPH_OFFLINE=0

# --- Database -----------------------------------------------------------------
# Postgres connection (required). The menu, orders and sessions are stored here.
# Start a local server with Docker:
#   docker run -d --name dinegraph-db --restart unless-stopped -e POSTGRES_PASSWORD=dinegraph \
#     -e POSTGRES_DB=dinegraph -v dinegraph-pgdata:/var/lib/postgresql/data -p 5432:5432 postgres:17-alpine
DATABASE_URL=postgresql://postgres:dinegraph@localhost:5432/dinegraph

# --- Web app and admin --------------------------------------------------------
# Frontend origins allowed to call the API, comma-separated.
DINEGRAPH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# If set, /admin routes need the header X-Admin-Token with this value.
# DINEGRAPH_ADMIN_TOKEN=change-me

# --- Kitchen ------------------------------------------------------------------
# Seconds each cook and serve attempt takes. 0 = instant; 4 looks good on the kitchen screen.
DINEGRAPH_KITCHEN_SECONDS=0
# How long a request waits for the agent to pause before returning busy=true.
DINEGRAPH_WAIT_SECONDS=15
